####################
# Global variables #
####################

# mod key
set $mod Mod4

# i3-bar
set $bar i3blocks

set $mail thunderbird
set $browser google-chrome-stable
set $music pear-desktop

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:FiraCode 10

# key repeating
exec_always --no-startup-id xset r rate 200 40

# Monitor config:
exec_always --no-startup-id "$XDG_CONFIG_HOME/i3/monitor-setup.sh"

# start redshift, -P to reset
exec_always --no-startup-id "pkill redshift; sleep 1; redshift -x; redshift -P -c $XDG_CONFIG_HOME/redshift/redshift.conf"

# picom
exec_always --no-startup-id picom

# make windows float
for_window [class="floating"] floating enable
#for_window [title="st"] floating enable
for_window [class="ts-256color"] floating enable
for_window [title="mpv webcam"] floating enable
for_window [title="mpv webcam"] sticky enable

# remove window borders
for_window [class="^.*$"] border none

gaps inner 10
# smart_gaps on
smart_borders on

# restart xautolock with 5 min timer
exec_always --no-startup-id killall xautolock
exec_always --no-startup-id xautolock -time 5 -locker "$XDG_CONFIG_HOME/i3/i3lock-color.sh" -detectsleep

# start dunst daemon
exec_always --no-startup-id "$HOME/.scripts/dunst-restart.sh"

################
# Rofi scripts #
################

# App launcher
bindsym $mod+space exec "rofi -modi drun,run -show drun"

bindsym $mod+p exec --no-startup-id powermenu

# wallpaper
exec_always --no-startup-id load-wp
bindsym $mod+w exec --no-startup-id select-wp

# media menu
bindsym $mod+m exec --no-startup-id musicmenu

# signal bar for changes
set $signal_bar pkill -SIGRTMIN+10 i3blocks

# brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +5% && $signal_bar
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- && $signal_bar

##########
# Volume #
##########

# init to 0
exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 0%

# start watcher for bar update
exec_always --no-startup-id "$XDG_CONFIG_HOME/i3/volume-watcher.sh"

# keybinds
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 1%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 1%-
bindsym Shift+XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 10%+
bindsym Shift+XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 10%-

bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_SOURCE@ toggle

# pause/play & next/prev
bindsym XF86AudioPlay exec playerctl play-pause && $signal_bar
bindsym XF86AudioNext exec playerctl next && $signal_bar
bindsym XF86AudioPrev exec playerctl previous && $signal_bar

###################
# Caps & Num Lock #
###################

# signal bar for capslock & numlock
bindsym --release Caps_Lock exec --no-startup-id $signal_bar
bindsym --release Num_Lock exec --no-startup-id $signal_bar

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

#################################
# Shortcuts for common programs #
#################################

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# start a floating terminal
bindsym $mod+Shift+Return exec i3-sensible-terminal -c floating

bindsym $mod+b exec $browser

# screenshot selection
bindsym Print exec --no-startup-id "screenshot sel"
# screenshot full window
bindsym Shift+Print exec --no-startup-id "screenshot full"

bindsym XF86HomePage exec "$XDG_CONFIG_HOME/i3/focus-app.sh google-chrome $browser"
bindsym XF86Mail exec "$XDG_CONFIG_HOME/i3/focus-app.sh Mail $mail"
# bindsym XF86Explorer
# bindsym XF86Calculator
bindsym XF86Tools exec "$XDG_CONFIG_HOME/i3/focus-app.sh com.github.th_ch.youtube_music $music"

# kill focused window
bindsym $mod+Shift+Q kill

# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# alternatively, you can use the cursor keys:
# bindsym $mod+Left focus left
# bindsym $mod+Down focus down
# bindsym $mod+Up focus up
# bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# alternatively, you can use the cursor keys:
# bindsym $mod+Shift+Left move left
# bindsym $mod+Shift+Down move down
# bindsym $mod+Shift+Up move up
# bindsym $mod+Shift+Right move right

# split in vertical orientation
bindsym $mod+v split v

# split in horizontal orientation
bindsym $mod+Shift+v split h

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+z layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+g floating toggle

# toggle sticky
bindsym $mod+Shift+s sticky toggle

# change focus between tiling / floating windows
bindsym $mod+g focus mode_toggle

# focus the parent container
bindsym $mod+q focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

set $mon_odd HDMI-A-0
set $mon_even eDP

workspace $ws1 output $mon_odd
workspace $ws2 output $mon_even
workspace $ws3 output $mon_odd
workspace $ws4 output $mon_even
workspace $ws5 output $mon_odd
workspace $ws6 output $mon_even
workspace $ws7 output $mon_odd
workspace $ws8 output $mon_even
workspace $ws9 output $mon_odd
workspace $ws10 output $mon_even

# cycle workspace
bindsym $mod+Tab workspace next

# switch to workspace
bindsym $mod+ampersand workspace number $ws1
bindsym $mod+eacute workspace number $ws2
bindsym $mod+quotedbl workspace number $ws3
bindsym $mod+apostrophe workspace number $ws4
bindsym $mod+parenleft workspace number $ws5
bindsym $mod+minus workspace number $ws6
bindsym $mod+egrave workspace number $ws7
bindsym $mod+underscore workspace number $ws8
bindsym $mod+ccedilla workspace number $ws9
bindsym $mod+agrave workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+eacute move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+egrave move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+ccedilla move container to workspace number $ws9
bindsym $mod+Shift+agrave move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload; exec --no-startup-id $set_monitor
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart; exec --no-startup-id $set_monitor

# resize window (you can also use the mouse for that)
bindsym $mod+r mode "resize"
mode "resize" {
    # These bindings trigger as soon as you enter the resize mode

    # Pressing left will shrink the window’s width.
    # Pressing right will grow the window’s width.
    # Pressing up will shrink the window’s height.
    # Pressing down will grow the window’s height.
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym m resize grow width 10 px or 10 ppt

    # same bindings, but for the arrow keys
    # bindsym Left resize shrink width 10 px or 10 ppt
    # bindsym Down resize grow height 10 px or 10 ppt
    # bindsym Up resize shrink height 10 px or 10 ppt
    # bindsym Right resize grow width 10 px or 10 ppt

    # back to normal: Enter or Escape or $mod+r
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

include "$XDG_CACHE_HOME/theme/i3"
