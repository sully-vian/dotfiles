#!/usr/bin/env sh

set -euo pipefail

# fetch repos and default branches: "owner/repo default-branch"
# only show "owner/repo" with `--with-nth=1`
selection=$(gh repo list --json nameWithOwner,defaultBranchRef --jq '.[] | "\(.nameWithOwner) \(.defaultBranchRef.name)"' | fzf --with-nth=1)

repo=$(echo "$selection" | cut --delimiter=' ' --fields=1)
branch=$(echo "$selection" | cut --delimiter=' ' --fields=2)

# fetch file tree
files=$(gh api "repos/$repo/git/trees/$branch?recursive=1" --jq '.tree[] | select(.type="blob") | .path')

file=$(echo "$files" | fzf)

url="https://github.com/$repo/blob/$branch/$file"

xdg-open "$url"
