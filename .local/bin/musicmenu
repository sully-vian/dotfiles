#!/usr/bin/env sh

set -euo pipefail

# music menu script

status=$(playerctl status)

# options
if [ "$status" = "Playing" ]; then
    playpause=" Pause"
    playpause=""
else
    playpause=" Play"
    playpause=""
fi
next=" Next"
next=""
prev=""

# selected option
selected=$(printf "%s\n%s\n%s" "$prev" "$playpause" "$next" | dmenu -fn "monospace:size=20" -i -c -l 3)

# action
case $selected in
"$playpause")
    playerctl play-pause
    ;;
"$next")
    playerctl next
    ;;
"$prev")
    playerctl previous
    ;;
esac
