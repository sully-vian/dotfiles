#!/usr/bin/env sh

set -euo pipefail

usage() {
    cmd=$(basename "$0")
    printf "%s: capture a screenshot and copy it to the clipboard\n\n" "$cmd"
    printf "Usage:\n"
    printf "\t%s [sel|full]\n" "$cmd"
    printf "sel:  Capture selection\n"
    printf "full: Capture full screen\n"
    exit 1
}

take_screenshot() {
    if ! import "$@" "$FULL_PATH"; then
        notify-send --urgency=low "Screenshot canceled" "No image was saved"
        exit 1
    fi
}

if [ "$#" -ne 1 ]; then
    usage
fi

SCREENSHOT_DIR="$HOME/Pictures"

mkdir --parents "$SCREENSHOT_DIR"

FILENAME="screenshot-$(date +%Y-%m-%d-%H-%M-%S).png"
FULL_PATH="$SCREENSHOT_DIR/$FILENAME"

case "$1" in
sel)
    take_screenshot
    ;;
full)
    take_screenshot -window root
    ;;
*)
    usage
    ;;
esac

notify-send --urgency=low "Screenshot captured" "Saved to $FULL_PATH"

mime=$(file --brief --mime-type "$FULL_PATH")
xclip -selection clipboard -target "$mime" -in <"$FULL_PATH"
