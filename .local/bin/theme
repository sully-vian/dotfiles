#!/usr/bin/env sh

set -euo pipefail

# Generate config files from templates

. "$XDG_CONFIG_HOME/theme/theme.sh"

COLOR_VARS='$color0:$color1:$color2:$color3:$color4:$color5:$color6:$color7:$color8:$color9:$color10:$color11:$color12:$color13:$color14:$color15'
BASE_VARS='$base00:$base01:$base02:$base03:$base04:$base05:$base06:$base07:$base08:$base09:$base0A:$base0B:$base0C:$base0D:$base0E:$base0F'

TEMPLATES="$XDG_CONFIG_HOME/theme/templates"

envsubst "$COLOR_VARS" <"$TEMPLATES/osc4.sh" >"$XDG_CACHE_HOME/theme/osc4.sh"
envsubst "$BASE_VARS" <"$TEMPLATES/bat.tmTheme" >"$(bat --config-dir)/themes/bat.tmTheme"
