#!/usr/bin/env sh

set -euo pipefail

if [ $# -gt 1 ]; then # argc > 1 -> pass through
    exec nvim "$@"
fi

if [ $# -eq 0 ]; then # argc == 0 -> open current directory
    exec nvim -- .
fi

if [ -d "$1" ]; then # argv[1] is directory -> cd and open
    cd "$1"
    exec nvim -- .
fi

# argv[1] is file -> cd into parent dir and open file
cd "$(dirname -- "$1")"
exec nvim -- "$(basename -- "$1")"
